{
  "name": "@seamless-auth/types",
  "version": "0.14.0",
  "description": "Shared TypeScript types and Zod schemas for SeamlessAuth.",
  "author": "Fells Code, LLC",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./role": {
      "types": "./dist/schemas/role/schema.d.ts",
      "import": "./dist/schemas/role/schema.js"
    },
    "./role/matching": {
      "types": "./dist/schemas/role/matching.d.ts",
      "import": "./dist/schemas/role/matching.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fells-code/seamless-auth-types.git"
  },
  "bugs": {
    "url": "https://github.com/fells-code/seamless-auth-types/issues"
  },
  "homepage": "https://github.com/fells-code/seamless-auth-types#readme",
  "keywords": [
    "typescript",
    "zod",
    "schemas",
    "authentication",
    "webauthn",
    "passkeys",
    "seamless-auth"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:stable": "npm run build && changeset publish",
    "check-npm-build": "npm pack --dry-run"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  }
}
